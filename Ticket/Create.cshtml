@model TicketTypeFormViewModel
@{
    ViewData["Title"] = "New Ticket Type";
    bool isSeated = ViewBag.IsSeated;
}

<div class="card p-4 col-md-6">
    <h4 class="mb-3">New Ticket Type</h4>
    <form asp-action="Create" method="post">
        <input type="hidden" asp-for="EventId" />
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="mb-3"><label class="form-label">Name (e.g. VIP, Standard, Early Bird)</label><input asp-for="Name" class="form-control" /></div>
        <div class="mb-3"><label class="form-label">Price (RM)</label><input asp-for="Price" type="number" step="0.01" class="form-control" /></div>

        @if (isSeated)
        {
            <div class="mb-3">
                <label class="form-label">Number of Seats for this Ticket Type</label>
                <input asp-for="SeatQuantity" type="number" min="1" class="form-control" />
                <div class="form-text">
                    @((int)ViewBag.SeatsAllocated) of @((int)ViewBag.VenueCapacity) seats already allocated for this event.
                    The system will automatically lay these out as a seat grid — you won't need to click each seat by hand.
                </div>
            </div>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label">Quantity Available</label>
                <input asp-for="QuantityAvailable" type="number" class="form-control" />
            </div>
        }

        <button class="btn btn-primary">Create</button>
        <a class="btn btn-link" asp-action="Index" asp-route-eventId="@Model.EventId">Cancel</a>
    </form>
</div>
