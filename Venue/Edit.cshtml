@model Venue
@{ ViewData["Title"] = "Edit Venue"; }

<div class="card p-4 col-md-8">
    <h4 class="mb-3">Edit Venue</h4>
    <form asp-action="Edit" asp-route-id="@Model.VenueId" method="post">
        <input type="hidden" asp-for="VenueId" />
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="row">
            <div class="col-md-6 mb-3"><label class="form-label">Name</label><input asp-for="Name" class="form-control" /></div>
            <div class="col-md-6 mb-3"><label class="form-label">Capacity</label><input asp-for="Capacity" type="number" class="form-control" /></div>
        </div>
        <div class="mb-3"><label class="form-label">Address</label><input asp-for="Address" class="form-control" /></div>
        <div class="row">
            <div class="col-md-6 mb-3"><label class="form-label">Latitude</label><input asp-for="Latitude" class="form-control" /></div>
            <div class="col-md-6 mb-3"><label class="form-label">Longitude</label><input asp-for="Longitude" class="form-control" /></div>
        </div>
        <div class="form-check mb-3">
            <input asp-for="IsSeated" class="form-check-input" disabled />
            <label class="form-check-label">Seated venue (seat layout locked after creation)</label>
        </div>
        <input type="hidden" asp-for="IsSeated" />
        <input type="hidden" asp-for="Rows" />
        <input type="hidden" asp-for="SeatsPerRow" />
        <button class="btn btn-primary">Save</button>
        <a class="btn btn-link" asp-action="Index">Cancel</a>
    </form>
</div>
