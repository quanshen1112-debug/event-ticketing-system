@model Venue
@{ ViewData["Title"] = "New Venue"; }

<div class="card p-4 col-md-8">
    <h4 class="mb-3">New Venue</h4>
    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="row">
            <div class="col-md-6 mb-3"><label class="form-label">Name</label><input asp-for="Name" class="form-control" /></div>
            <div class="col-md-6 mb-3"><label class="form-label">Capacity</label><input asp-for="Capacity" type="number" class="form-control" /></div>
        </div>
        <div class="mb-3"><label class="form-label">Address</label><input asp-for="Address" class="form-control" /></div>
        <div class="row">
            <div class="col-md-6 mb-3"><label class="form-label">Latitude (for map)</label><input asp-for="Latitude" class="form-control" /></div>
            <div class="col-md-6 mb-3"><label class="form-label">Longitude (for map)</label><input asp-for="Longitude" class="form-control" /></div>
        </div>
        <div class="form-check mb-3">
            <input asp-for="IsSeated" class="form-check-input" id="isSeated" />
            <label class="form-check-label" for="isSeated">Seated venue (generates an interactive seat map)</label>
        </div>
        <div class="row" id="seatGridFields">
            <div class="col-md-6 mb-3"><label class="form-label">Rows</label><input asp-for="Rows" type="number" class="form-control" /></div>
            <div class="col-md-6 mb-3"><label class="form-label">Seats per Row</label><input asp-for="SeatsPerRow" type="number" class="form-control" /></div>
        </div>
        <button class="btn btn-primary">Create</button>
        <a class="btn btn-link" asp-action="Index">Cancel</a>
    </form>
</div>
