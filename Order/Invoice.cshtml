@model Order
@{ ViewData["Title"] = "E-Invoice"; Layout = null; }
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Invoice @Model.OrderNumber</title>
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" />
    <style>
        body { padding: 40px; }
        @@media print { .no-print { display: none; } }
    </style>
</head>
<body>
    <div class="d-flex justify-content-between mb-4">
        <div>
            <h2>EventXpress</h2>
            <p class="text-muted mb-0">Event Ticketing & Management</p>
        </div>
        <div class="text-end">
            <h4>E-Invoice</h4>
            <p class="mb-0">Order #: @Model.OrderNumber</p>
            <p class="mb-0">Date: @Model.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</p>
        </div>
    </div>

    <p><strong>Billed To:</strong> @Model.Customer?.FullName (@Model.Customer?.Email)</p>

    <table class="table table-bordered">
        <thead class="table-light">
            <tr><th>Event</th><th>Ticket Type</th><th>Seat / Qty</th><th>Unit Price</th><th>Subtotal</th></tr>
        </thead>
        <tbody>
        @foreach (var item in Model.OrderItems)
        {
            <tr>
                <td>@item.TicketType?.Event?.Title</td>
                <td>@item.TicketType?.Name</td>
                <td>@(item.Seat != null ? item.Seat.SeatCode : $"x{item.Quantity}")</td>
                <td>RM @item.UnitPrice.ToString("0.00")</td>
                <td>RM @item.Subtotal.ToString("0.00")</td>
            </tr>
        }
        </tbody>
        <tfoot>
            <tr><th colspan="4" class="text-end">Total Paid</th><th>RM @Model.TotalAmount.ToString("0.00")</th></tr>
        </tfoot>
    </table>

    <p>Payment Method: @Model.Payment?.Method &mdash; Transaction Ref: @Model.Payment?.TransactionRef</p>
    <p class="text-muted small">This is a system-generated e-invoice and does not require a signature.</p>

    <div class="no-print text-center mt-4">
        <button class="btn btn-primary" onclick="window.print()">Print / Save as PDF</button>
    </div>
</body>
</html>
