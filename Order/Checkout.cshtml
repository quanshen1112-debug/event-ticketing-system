@model CheckoutViewModel
@{ ViewData["Title"] = "Checkout"; }

<h4 class="mb-3">Checkout</h4>

<div class="row">
    <div class="col-md-7">
        <div class="card p-4">
            <h5>Payment Method</h5>
            <div asp-validation-summary="All" class="text-danger"></div>
            <form asp-action="Checkout" method="post">
                <div class="mb-3">
                    <label class="form-label">Payment Method</label>
                    <select asp-for="PaymentMethod" class="form-select">
                        <option value="@PaymentMethod.CreditCard">Credit / Debit Card</option>
                        <option value="@PaymentMethod.OnlineBanking">Online Banking (FPX)</option>
                        <option value="@PaymentMethod.EWallet">E-Wallet</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label asp-for="ReferenceNumber" class="form-label"></label>
                    <input asp-for="ReferenceNumber" class="form-control" placeholder="e.g. the reference number from your bank/e-wallet app" />
                    <span asp-validation-for="ReferenceNumber" class="text-danger"></span>
                </div>
                <p class="text-muted small">This is a simulated payment for coursework purposes; enter any reference number to proceed. No real transaction is processed.</p>
                <button class="btn btn-primary w-100">Pay RM @Model.Cart.Total.ToString("0.00")</button>
            </form>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card p-4">
            <h5>Order Summary</h5>
            @foreach (var item in Model.Cart.Items)
            {
                <div class="d-flex justify-content-between border-bottom py-1">
                    <span>@item.EventTitle &mdash; @item.TicketTypeName @(item.SeatCode != null ? $"({item.SeatCode})" : $"x{item.Quantity}")</span>
                    <span>RM @item.Subtotal.ToString("0.00")</span>
                </div>
            }
            <div class="d-flex justify-content-between fw-bold mt-2">
                <span>Total</span><span>RM @Model.Cart.Total.ToString("0.00")</span>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
