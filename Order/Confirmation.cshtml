@model OrderConfirmationViewModel
@{ ViewData["Title"] = "Order Confirmed"; var o = Model.Order; }

<div class="text-center mb-4">
    <i class="fa-solid fa-circle-check text-success" style="font-size:48px;"></i>
    <h3 class="mt-2">Booking Confirmed!</h3>
    <p class="text-muted">Order #@o.OrderNumber</p>
    <a class="btn btn-outline-primary btn-sm" asp-action="Invoice" asp-route-id="@o.OrderId"><i class="fa-solid fa-file-invoice"></i> View / Print E-Invoice</a>
</div>

<div class="row g-3">
    @foreach (var item in o.OrderItems)
    {
        <div class="col-md-4">
            <div class="card p-3 text-center">
                <h6>@item.TicketType?.Event?.Title</h6>
                <p class="text-muted small mb-1">@item.TicketType?.Name @(item.Seat != null ? $"- Seat {item.Seat.SeatCode}" : $"x{item.Quantity}")</p>
                <img src="data:image/png;base64,@item.QrCodeBase64" style="width:150px;margin:0 auto;" />
                <p class="small text-muted mt-2">Ticket Code: <strong>@item.TicketCode</strong></p>
            </div>
        </div>
    }
</div>

<div class="text-center mt-4">
    <a class="btn btn-primary" asp-action="History">View My Orders</a>
</div>
