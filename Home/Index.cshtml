@model List<Event>
@{ ViewData["Title"] = "Home"; }

<div class="brand-hero p-5 mb-4">
    <h1 class="fw-bold">Find your next event.</h1>
    <p class="lead mb-3">Concerts, conferences, sports and workshops &mdash; book seats or tickets in seconds.</p>
    <a class="btn btn-light fw-semibold" asp-controller="Event" asp-action="Index">Browse Events <i class="fa-solid fa-arrow-right"></i></a>
</div>

<h4 class="mb-3">Upcoming Events</h4>
<div class="row g-3">
    @foreach (var ev in Model)
    {
        <div class="col-md-4">
            <div class="card event-card h-100">
                <img src="@(string.IsNullOrEmpty(ev.BannerImagePath) ? "https://placehold.co/400x200?text=" + Uri.EscapeDataString(ev.Title) : ev.BannerImagePath)" class="card-img-top" />
                <div class="card-body">
                    <span class="badge bg-primary mb-2">@ev.Category?.Name</span>
                    <h5 class="card-title">@ev.Title</h5>
                    <p class="text-muted mb-1"><i class="fa-solid fa-calendar"></i> @ev.StartDateTime.ToString("dd MMM yyyy, h:mm tt")</p>
                    <p class="text-muted"><i class="fa-solid fa-location-dot"></i> @ev.Venue?.Name</p>
                    <a class="btn btn-outline-primary btn-sm" asp-controller="Event" asp-action="Details" asp-route-id="@ev.EventId">View Details</a>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <p class="text-muted">No upcoming events published yet. Check back soon!</p>
    }
</div>
