@model List<Event>
@{ ViewData["Title"] = "My Events"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>My Events</h4>
    <a class="btn btn-primary" asp-action="Create"><i class="fa-solid fa-plus"></i> New Event</a>
</div>

<table class="table bg-white">
    <thead><tr><th>Title</th><th>Category</th><th>Venue</th><th>Date</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var ev in Model)
    {
        <tr>
            <td>@ev.Title</td>
            <td>@ev.Category?.Name</td>
            <td>@ev.Venue?.Name</td>
            <td>@ev.StartDateTime.ToString("dd MMM yyyy, h:mm tt")</td>
            <td>
                @{
                    var badge = ev.Status switch
                    {
                        EventStatus.Published => "bg-success",
                        EventStatus.Draft => "bg-secondary",
                        EventStatus.Cancelled => "bg-danger",
                        _ => "bg-dark"
                    };
                }
                <span class="badge @badge">@ev.Status</span>
            </td>
            <td>
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@ev.EventId">Edit</a>
                <a class="btn btn-sm btn-outline-primary" asp-controller="Ticket" asp-action="Index" asp-route-eventId="@ev.EventId">Tickets</a>
                <form asp-action="Delete" asp-route-id="@ev.EventId" method="post" class="d-inline" onsubmit="return confirm('Delete this event?');">
                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
