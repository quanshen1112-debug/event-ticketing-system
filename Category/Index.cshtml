@model List<Category>
@{ ViewData["Title"] = "Categories"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Categories</h4>
    <a class="btn btn-primary" asp-action="Create"><i class="fa-solid fa-plus"></i> New Category</a>
</div>

<table class="table bg-white">
    <thead><tr><th>Name</th><th>Chinese Name</th><th>Description</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.Name</td>
            <td>@c.NameZh</td>
            <td>@c.Description</td>
            <td>
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@c.CategoryId">Edit</a>
                <form asp-action="Delete" asp-route-id="@c.CategoryId" method="post" class="d-inline" onsubmit="return confirm('Delete this category?');">
                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
