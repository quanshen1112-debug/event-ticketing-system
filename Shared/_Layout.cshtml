<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - EventXpress</title>
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark" style="background:#1e1b4b;">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-ticket"></i> EventXpress
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Event" asp-action="Index">Browse Events</a></li>

                    @if (User.IsInRole("Organizer"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Event" asp-action="MyEvents">My Events</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Report" asp-action="Dashboard">Sales Report</a></li>
                    }
                    @if (User.IsInRole("Customer"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Order" asp-action="History">My Orders</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Cart" asp-action="Index"><i class="fa-solid fa-cart-shopping"></i> Cart</a></li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Users</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Category" asp-action="Index">Categories</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Venue" asp-action="Index">Venues</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Report" asp-action="Dashboard">Reports</a></li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Profile"><i class="fa-solid fa-user"></i> @User.Identity.Name</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Logout">Logout</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-3">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">@TempData["Message"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @RenderBody()
    </div>

    <footer class="text-center text-muted py-4 mt-5">
        &copy; @DateTime.Now.Year EventXpress &mdash; AMIT2014 Team Project
    </footer>

    <script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="~/lib/chart.js/chart.umd.min.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/site.js"></script>
    <script src="~/js/banner-crop.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
